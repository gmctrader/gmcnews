# Copy this file to .env and fill in your key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for login/signup to be secure. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Set the real value as an environment variable in Render's dashboard too
# (Environment tab on your service) -- not just in this local file. Anyone
# who has this value can forge a valid login session.
AUTH_SECRET_KEY=

# Postgres connection string (Supabase, Neon, Render Postgres, etc.).
# Without this set, accounts/profiles fall back to a local SQLite file,
# which Render's free web-service tier WIPES on every deploy. Set this
# in Render's Environment tab, not just here, for accounts to survive.
DATABASE_URL=
