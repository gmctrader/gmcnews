# Copy this file to .env and fill in your keys. Both are free, no card needed.
# Groq (AI analysis):   https://console.groq.com/keys
# Tavily (web search):  https://app.tavily.com
# The dashboard users enter their own keys in Settings; these env vars are only
# used by server-side helpers (e.g. /api/news/upcoming?enrich=true).
GROQ_API_KEY=
TAVILY_API_KEY=
# Optional: override the Groq model (default openai/gpt-oss-120b, falls back to llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Required for account security. Generate a random 64-character secret and
# configure it in Vercel Environment Variables; never commit the actual value.
AUTH_SECRET_KEY=

# Persistent Postgres connection string, for example from a Vercel Marketplace
# Neon or Supabase integration. Production accounts require this and AUTH_SECRET_KEY.
# Without DATABASE_URL, Vercel SQLite is ephemeral and cannot persist accounts.
DATABASE_URL=

# Optional -- any/all of these can be set to let the app SEND signals
# out as normal trading-signal messages via POST /api/signals/{symbol}/send
# or /api/signals/broadcast. Leave blank to skip a channel; nothing
# breaks if all three are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
